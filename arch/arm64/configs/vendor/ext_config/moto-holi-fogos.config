#
# Please avoid changing the Qualcomm defconfig files and use this file to
# add any Motorola-specific configuration changes that are applicable to
# userdebug, eng, and user builds.
#
# After building, a list of all of the config files that are used can be found
# at the top of:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/mapphone_defconfig
#
# The actual output of the kernel configuration system can be found at:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/.config
#
# You can check the .config file to verify that your configuration option is
# being set as expected.
#
CONFIG_FOGOS_DTB=y
# CONFIG_NFC_QTI_I2C is not set
CONFIG_FS_EPOLL_WAKEUP_DEBUG=y
CONFIG_ZRAM_WRITEBACK=y
# CONFIG_THERMAL_STATISTICS is not set
# CONFIG_REGULATOR_QPNP_LCDB is not set
# CONFIG_UFSTW is not set
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CAM_SENSOR_PROBE_RETRY=y
CONFIG_MOT_DONGWOON_OIS_AF_DRIFT=y
CONFIG_SND_SOC_FS1815=m
#CONFIG_NFC_QTI_I2C=m
CONFIG_MSM_TZ_QSEE_LOG=y
CONFIG_AF_NOISE_ELIMINATION=y
# CONFIG_TOUCHSCREEN_FTS is not set
CONFIG_FELICA_MOUNT_BLOCK=y
# CONFIG_UFSHPB is not set
# CONFIG_UFSTW is not set
# CONFIG_SCSI_SKHPB is not set
# CONFIG_MICRON_HPB is not set
CONFIG_NFC=y
CONFIG_SEC_NFC_PRODUCT_N5=y
CONFIG_SEC_NFC=m
CONFIG_SEC_NFC_IF_I2C=y
CONFIG_QUP0_SE2_AP=y
CONFIG_CAMERA_FLASH_IIC_COMPATIBLE=y
CONFIG_EROFS_FS_PCPU_KTHREAD=y
CONFIG_EROFS_FS_PCPU_KTHREAD_HIPRI=y
CONFIG_MMAP_READAROUND_LIMIT=y
CONFIG_MOT_SENSOR_PRE_POWERUP=y
CONFIG_MOT_SECURE_CAMERA=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_ACT_BPF=y
CONFIG_USB_NET_CDC_EEM=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_AQC111=y
CONFIG_USB_RTL8150=y

# For KernelSU
# CONFIG_KPROBES is not set

# Custom
# Samsung SSG
CONFIG_MQ_IOSCHED_SSG=y
CONFIG_MQ_IOSCHED_SSG_CGROUP=y
CONFIG_MQ_SSG_DEFAULT=y

# ZRAM
CONFIG_CRYPTO_LZ4KD=y
CONFIG_CRYPTO_LZ4HC=y
CONFIG_CRYPTO_LZ4=y
CONFIG_ZSMALLOC=y
# CONFIG_ZRAM is not set
CONFIG_HYBRIDSWAP_ZRAM_DEF_COMP_LZ4=y

# Network
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_IP6_NF_MATCH_HL=y
CONFIG_IP6_NF_TARGET_HL=y

CONFIG_TCP_CONG_ADVANCED=y
# CONFIG_TCP_CONG_BIC is not set
CONFIG_TCP_CONG_CUBIC=y
# CONFIG_TCP_CONG_WESTWOOD is not set
# CONFIG_TCP_CONG_HTCP is not set
# CONFIG_TCP_CONG_HSTCP is not set
# CONFIG_TCP_CONG_HYBLA is not set
# CONFIG_TCP_CONG_VEGAS is not set
# CONFIG_TCP_CONG_NV is not set
# CONFIG_TCP_CONG_SCALABLE is not set
# CONFIG_TCP_CONG_LP is not set
# CONFIG_TCP_CONG_VENO is not set
# CONFIG_TCP_CONG_YEAH is not set
# CONFIG_TCP_CONG_ILLINOIS is not set
# CONFIG_TCP_CONG_DCTCP is not set
# CONFIG_TCP_CONG_CDG is not set
CONFIG_TCP_CONG_BBR=y
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_DEFAULT_BBR=y
# CONFIG_DEFAULT_RENO is not set
CONFIG_DEFAULT_TCP_CONG="bbr"

CONFIG_NET_SCH_DEFAULT=y
CONFIG_NET_SCH_FQ=y
CONFIG_DEFAULT_FQ=y

# Power & Wakelocks
CONFIG_PM_WAKELOCKS_GC=y
CONFIG_CPU_IDLE_MULTIPLE_DRIVERS=n
CONFIG_CPU_IDLE_GOV_MENU=n
CONFIG_CPU_IDLE_GOV_TEO=y

# Misc
CONFIG_KSM=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
